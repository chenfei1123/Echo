       <string notr="true">/* 复选框指示器样式 - 位于标题左侧 */
QGroupBox::indicator {
    width: 18px;
    height: 18px;
    position: absolute;
    left: 5px;
    top: -1px;
}
/* 未选中状态的复选框图标 */
QGroupBox::indicator:unchecked {
    image: url(:/D:/复选框-未选.svg);
    background-color: transparent;
    border: none;
}

/* 选中状态的复选框图标 */
QGroupBox::indicator:checked {
    image: url(:/D:/复选选中 (1).svg);
    background-color: transparent;
    border: none;
}</string>
