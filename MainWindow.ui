   <widget class="QComboBox" name="comboBox">
    <property name="geometry">
     <rect>
      <x>616</x>
      <y>70</y>
      <width>71</width>
      <height>31</height>
     </rect>
    </property>
    <property name="sizePolicy">
     <sizepolicy hsizetype="Preferred" vsizetype="Preferred">
      <horstretch>0</horstretch>
      <verstretch>0</verstretch>
     </sizepolicy>
    </property>
    <property name="styleSheet">
     <string notr="true">/* 深色模式 QDoubleSpinBox 美化 */
QComboBox {
    background-color: #1E1E1E;      /* 深灰背景 */
    color: #FFFFFF;                 /* 白色文字 */
    border: 1px solid #3A3A3A;      /* 中灰色边框 */
    border-radius: 4px;             /* 圆角 */
	font:10pt &quot;Segoe UI&quot;;
    selection-color: white;         /* 选中文本颜色 */
}

QComboBox::drop-down {
	padding:7px 3px;
    image: url(:/D:/drop-down.svg); /* 浅色下箭头 */
    width: 15px;
    height: 15px;
}

/* 禁用状态 */
QComboBox:disabled {
    background-color: #1A1A1A;      /* 更暗背景 */
    color: #7A7A7A;                 /* 灰色文字 */
    border: 1px solid #2D2D2D;      /* 深灰边框 */
}

/* 鼠标悬停效果 */
QComboBox:hover {
    border: 1px solid #4A4A4A;      /* 边框变亮 */
}
/* 完全隐藏垂直滚动条 */
QComboBox QAbstractItemView::scroll-bar:vertical {
    background: transparent;  /* 透明背景 */
    width: 0px;              /* 宽度设为0 */
}
</string>
    </property>
