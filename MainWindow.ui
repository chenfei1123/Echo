    <property name="styleSheet">
     <string notr="true">/* 设置所有项的行高 */
QTreeWidget::item {
    height: 20px;
    color: white; /* 白色字体 */
    /*background-color: #19232D; /* 使用您提供的背景色 */
    /*border-bottom: 1px solid rgb(40, 50, 60);*/
	border-left-color: rgb(79, 195, 247);
}

/* 鼠标悬停在选项上的效果 */
QTreeWidget::item:hover {
    background-color: /*rgb(45, 60, 80)*/rgba(79, 195, 247, 0.1);
    color: white;
    border: 1px solid rgb(65, 85, 105);
}

/* 选项被选中时的效果 */
QTreeWidget::item:selected {
	
    color: white;
    border: 1px solid rgb(75, 105, 135);
}

/* 选项被选中且拥有焦点时的效果 */
QTreeWidget::item:selected:active {
    background-color: /*rgb(65, 95, 125)*/rgba(79, 195, 247, 0.15);
    color: white;
}

/* 整个QTreeWidget样式 */
QTreeWidget {
	font: 10pt;
	background-color: rgb(17, 20, 29);
    /*background-color: #1E2832; /* 使用您提供的背景色 */
    color: white; /* 白色字体 */
    /*border: 1px solid rgb(45, 55, 65);*/
	border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 0px;
    outline: 0; /* 移除焦点边框 */
    /*alternate-background-color: rgb(30, 40, 50); /* 交替行颜色 */
    show-decoration-selected: 1; /* 确保选中时装饰区域也显示 */
}
/* 未选中状态 */
QTreeWidget::indicator:unchecked {
    image: url(:/D:/复选框-未选.svg);
}

/* 选中状态 */
QTreeWidget::indicator:checked {
    image: url(:/D:/复选选中 (1).svg);
}
QTreeWidget::branch:has-siblings:!adjoins-item{ 


                image:url(:/D:/branch-vline.svg) 0;
            }
            QTreeWidget::branch:has-siblings:adjoins-item{
                image:url(:/D:/branch-more.svg) 0;
            }   
            QTreeWidget::branch:!has-children:!has-siblings:adjoins-item{
                image:url(:/D:/branch-end.svg) 0;
            }
            QTreeWidget::branch:has-children:!has-siblings:closed,
            QTreeWidget::branch:closed:has-children:has-siblings{
                border-image:none;
                image:url(:/D:/折叠.svg);
            }
            QTreeWidget::branch:open:has-children:!has-siblings,
            QTreeWidget::branch:open:has-children:has-siblings{
                border-image:none;
                image:url(:/D:/折叠.svg);
            };



</string>
