     <widget class="QDoubleSpinBox" name="doubleSpinBox_15">
      <property name="geometry">
       <rect>
        <x>280</x>
        <y>140</y>
        <width>71</width>
        <height>31</height>
       </rect>
      </property>
      <property name="styleSheet">
       <string notr="true">/* 深色模式 QDoubleSpinBox 美化 */
QDoubleSpinBox {
	 border: 1px solid #37474F;
    background-color: rgba(23, 28, 40,0.3);
    color: #FFFFFF;                 /* 白色文字 */
    border: 1px solid #3A3A3A;      /* 中灰色边框 */
    border-radius: 4px;             /* 圆角 */
    font: 10pt &quot;Microsoft YaHei UI&quot;; /* 微软雅黑字体 */
   /*selection-background-color: #19232D; /* 选中文本背景-主色调 */
    selection-color: white;         /* 选中文本颜色 */
}


/* 上下按钮区域 */
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
   background-color: rgba(23, 28, 40,0.3);      /* 按钮背景 */
    border-left: 1px solid #3A3A3A; /* 左侧分隔线 */
    width: 13px;                   /* 按钮宽度 */
   border-top-right-radius: 3px;   /* 右上圆角 */
    border-bottom-right-radius: 3px;/* 右下圆角 */
}

/* 按钮悬停效果 */
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: rgb(66, 79, 95);      /* 悬停变亮 */
}

/* 按钮按下效果 */
QDoubleSpinBox::up-button:pressed, QDoubleSpinBox::down-button:pressed {
    background-color: rgb(66, 79, 95);     /* 按下变暗 */
}

/* 上下箭头图标 */
QDoubleSpinBox::up-arrow {
    image: url(:/D:/drop-up.svg); /* 浅色上箭头 */
    width: 12px;
    height: 12px;
}

QDoubleSpinBox::down-arrow {
    image: url(:/D:/drop-down.svg); /* 浅色下箭头 */
    width: 12px;
    height: 12px;
}

/* 禁用状态 */
QDoubleSpinBox:disabled {
    background-color: #1A1A1A;      /* 更暗背景 */
    color: #7A7A7A;                 /* 灰色文字 */
    border: 1px solid #2D2D2D;      /* 深灰边框 */
}

/* 鼠标悬停效果 */
QDoubleSpinBox:hover {
    border: 1px solid #4A4A4A;      /* 边框变亮 */
}
</string>
      </property>
      <property name="maximum">
       <double>1.000000000000000</double>
      </property>
      <property name="singleStep">
       <double>0.010000000000000</double>
      </property>
      <property name="value">
       <double>1.000000000000000</double>
      </property>
     </widget>
