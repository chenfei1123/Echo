       <property name="styleSheet">
        <string notr="true">QPushButton{
font-weight: bold;
    border: 1px solid #37474F;
    border-radius: 4px;
    margin-top: 1px;
    padding-top: 1px;
background-color: rgba(23, 28, 40,0.3);
    color: #E0E0E0;
