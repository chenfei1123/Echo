      <property name="styleSheet">
       <string notr="true">QPushButton::hover {  
	
     border-radius: 0px;
	border-image: url(:/D:/切换 (1).svg); /* 图片路径 */
    }

QPushButton
{
	background-color:transparent;

    /*color: #EDF2F7;*/
    border-radius: 0px;
    border-image: url(:/D:/切换.svg); /* 图片路径 */
    min-width :24px; /* 最小宽度 */
    min-height : 24px; /* 最小高度 */
    max-width : 24px; /* 最大宽度 */
    max-height : 24px; /* 最大高度 */
    background-position: center;  /*居中显示 */
    background-&gt;attachment:fixed;  /* 固定 */
    background-repeat: repeat-n; /* 是否重复 repeat-y是重复*/

outline: 0;
}</string>
