      <property name="text">
       <string>蛇手：摆好第一次分身的方向，鼠标放在合球的点位，按下快捷键，鼠标放在箭头的左右，决定了旋转合球的方向</string>
      </property>
      <property name="textFormat">
       <enum>Qt::TextFormat::PlainText</enum>
      </property>
      <property name="alignment">
